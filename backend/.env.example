PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/nexa
JWT_SECRET=nexa_production_grade_jwt_secret_token_key_9948271
ENCRYPTION_KEY=nexa_super_secure_aes256_encryption_key_32_bytes_long_12345
