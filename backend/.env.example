PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/nexa?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
ENCRYPTION_KEY=your_32_byte_aes_encryption_key_placeholder_123
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Google Gemini AI Configuration (Strictly Free-Tier Only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_RATE_LIMIT=20
AI_RATE_WINDOW_MS=900000

# Optional Cloud Storage (S3 / Cloudinary)
STORAGE_TYPE=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your-bucket-name

# Email Delivery Configuration (Resend HTTPS API - Recommended for Production)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="NEXA Security" <onboarding@resend.dev>

# Optional / Legacy SMTP Delivery Configuration (Development fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_google_app_password
