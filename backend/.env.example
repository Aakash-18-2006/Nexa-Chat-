# Optional External AI API keys (Google Gemini or OpenAI). 
# If left blank, NEXA's high-performance built-in contextual AI engine runs seamlessly!
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional Cloud Storage (S3 / Cloudinary)
STORAGE_TYPE=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=

# Gmail SMTP Email Delivery Configuration for Password Reset & Verification
# 1. Enable 2-Step Verification on your Google Account (akasuran6@gmail.com)
# 2. Generate a 16-character App Password at https://myaccount.google.com/apppasswords
# 3. Enter the 16-character App Password in SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=akasuran6@gmail.com
SMTP_PASS=your_16_char_google_app_password
EMAIL_FROM="NEXA Security" <akasuran6@gmail.com>
