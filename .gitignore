# ==========================================
# NEXA - Production Git Ignore Configuration
# ==========================================

# 1. Environment & Sensitive Credentials
.env
.env.*
.env.local
.env.*.local
*.pem
*.key
*.cert
*.crt
*.keystore
*.jks
id_rsa
id_rsa.pub

# Exception: Allow example template environment configs
!.env.example
!**/.env.example

# 2. Dependencies
node_modules/
**/node_modules/

# 3. Build & Production Outputs
dist/
**/dist/
build/
**/build/
dist-ssr/
.cache/
.parcel-cache/
.turbo/

# 4. Runtime Uploads & User Media (Keep directory with .gitkeep)
uploads/*
**/uploads/*
!**/uploads/.gitkeep

# 5. Logs & System Debug Files
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 6. Temporary Test Scripts & Scratch Files
scratch/
**/scratch/
tmp/
temp/

# 7. OS & Editor Cache
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.vercel
